{
  "name": "growshop-ecommerce",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main-standalone.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint && vitest run && next build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "electron": "node_modules\\electron\\dist\\electron.exe .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && node_modules\\electron\\dist\\electron.exe .\"",
    "electron:build": "cross-env BUILD_STANDALONE=true next build && electron-builder",
    "electron:build:win": "cross-env BUILD_STANDALONE=true next build && electron-builder --win",
    "electron:build:mac": "cross-env BUILD_STANDALONE=true next build && electron-builder --mac",
    "electron:build:linux": "cross-env BUILD_STANDALONE=true next build && electron-builder --linux",
    "icon:generate": "node scripts/generate-icon.js",
    "prepare:standalone": "node scripts/prepare-standalone.js",
    "build:installer": "electron-builder --config electron-builder-standalone.json --win"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-cloudinary": "^6.18.8",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.20.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "png-to-ico": "^3.0.2",
    "prisma-zod-generator": "^3.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
